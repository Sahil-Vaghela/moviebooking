# ==============================================================================
# Marquee — Environment Variable Template
# Copy this file to .env.local for local development.
# Never commit real secret keys or service account credentials to version control.
# ==============================================================================

# Firebase Client SDK Configuration (safe to expose in browser; protected by Firestore Rules)
# When running in AI Studio, firebase-applet-config.json provides default provisioned values,
# and any VITE_FIREBASE_* values defined here override them cleanly.
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_WEB_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_PROJECT_ID.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="YOUR_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_PROJECT_ID.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"
VITE_FIREBASE_DATABASE_ID="(default)"

# Optional: Future Firebase Cloud Functions / Secure Booking Backend Base URL
# Required to enable live server-side seat locks, payment gateway verification, and booking confirmations.
VITE_CLOUD_FUNCTIONS_BASE_URL=""

# Platform Runtime Variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
