rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened global primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidLanguagesList(langs) {
      return langs is list
        && langs.size() <= 8
        && (langs.size() == 0 || (langs[0] is string && langs[0].size() >= 1 && langs[0].size() <= 32));
    }

    // Validation blueprint for UserProfile (synchronized with firebase-blueprint.json)
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'preferredCityId',
          'preferredLanguages',
          'authProvider',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'phone',
          'preferredCityId',
          'preferredLanguages',
          'authProvider',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && data.uid == request.auth.uid
        && isValidId(data.uid)
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 160
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 20))
        && data.preferredCityId is string
        && data.preferredCityId.size() >= 1
        && data.preferredCityId.size() <= 64
        && isValidId(data.preferredCityId)
        && isValidLanguagesList(data.preferredLanguages)
        && data.authProvider is string
        && data.authProvider in ['password', 'google.com']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // /users/{userId} — Strict PII isolation, owner-only read/write, no list
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isVerified()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().authProvider == existing().authProvider
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'phone',
            'preferredCityId',
            'preferredLanguages',
            'updatedAt'
          ])
        );

      allow delete: if false;
    }

    // /bookings/{bookingId} — Server-minted bookings, owner-scoped read-only
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && isValidId(bookingId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // /showSeats/{showId}/seats/{seatId} — Server-managed seat availability (non-PII)
    match /showSeats/{showId}/seats/{seatId} {
      allow get: if isSignedIn() && isValidId(showId) && isValidId(seatId);
      allow list: if isSignedIn() && existing().showId == showId;
      allow create, update, delete: if false;
    }

    // /seatLocks/{lockId} — Server-managed temporary seat holds, owner-scoped read-only
    match /seatLocks/{lockId} {
      allow get: if isSignedIn() && isValidId(lockId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // /payments/{paymentId} — Server-verified payment records, owner-scoped read-only
    match /payments/{paymentId} {
      allow get: if isSignedIn() && isValidId(paymentId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && existing().userId == request.auth.uid;
      allow create, update, delete: if false;
    }
  }
}
